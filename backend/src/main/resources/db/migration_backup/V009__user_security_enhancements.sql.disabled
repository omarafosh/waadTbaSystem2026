-- =====================================================
-- User Security Enhancements Migration
-- Version: V009
-- Date: 2025-12-31
-- Purpose: Production readiness for User/RBAC module
-- =====================================================

-- Add security fields to users table
ALTER TABLE users 
    ADD COLUMN failed_login_count INT DEFAULT 0 NOT NULL,
    ADD COLUMN locked_until TIMESTAMP NULL,
    ADD COLUMN last_login_at TIMESTAMP NULL;

-- Add comments for clarity
COMMENT ON COLUMN users.failed_login_count IS 'Number of consecutive failed login attempts';
COMMENT ON COLUMN users.locked_until IS 'Account locked until this timestamp (NULL = not locked)';
COMMENT ON COLUMN users.last_login_at IS 'Timestamp of last successful login';

-- Create password reset tokens table
CREATE TABLE IF NOT EXISTS password_reset_tokens (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL,
    token VARCHAR(255) UNIQUE NOT NULL,
    expires_at TIMESTAMP NOT NULL,
    used BOOLEAN DEFAULT FALSE NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_token ON password_reset_tokens(token);
CREATE INDEX IF NOT EXISTS idx_user_expires ON password_reset_tokens(user_id, expires_at);
CREATE INDEX IF NOT EXISTS idx_expires ON password_reset_tokens(expires_at);

COMMENT ON TABLE password_reset_tokens IS 'Secure tokens for password reset workflow';
COMMENT ON COLUMN password_reset_tokens.token IS 'UUID-based secure token';
COMMENT ON COLUMN password_reset_tokens.expires_at IS 'Token expiration (typically 1 hour from creation)';
COMMENT ON COLUMN password_reset_tokens.used IS 'Whether token has been used (one-time use)';

-- Create email verification tokens table
CREATE TABLE IF NOT EXISTS email_verification_tokens (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL,
    token VARCHAR(255) UNIQUE NOT NULL,
    expires_at TIMESTAMP NOT NULL,
    verified BOOLEAN DEFAULT FALSE NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_evt_token ON email_verification_tokens(token);
CREATE INDEX IF NOT EXISTS idx_evt_user_expires ON email_verification_tokens(user_id, expires_at);
CREATE INDEX IF NOT EXISTS idx_evt_expires ON email_verification_tokens(expires_at);

COMMENT ON TABLE email_verification_tokens IS 'Tokens for email verification workflow';
COMMENT ON COLUMN email_verification_tokens.token IS 'UUID-based verification token';
COMMENT ON COLUMN email_verification_tokens.expires_at IS 'Token expiration (typically 24 hours)';
COMMENT ON COLUMN email_verification_tokens.verified IS 'Whether email has been verified';

-- Create user login attempts table
CREATE TABLE IF NOT EXISTS user_login_attempts (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT,
    username VARCHAR(50),
    ip_address VARCHAR(45),
    user_agent VARCHAR(500),
    success BOOLEAN NOT NULL,
    failed_reason VARCHAR(255),
    attempted_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_ula_user_attempted ON user_login_attempts(user_id, attempted_at);
CREATE INDEX IF NOT EXISTS idx_ula_username_attempted ON user_login_attempts(username, attempted_at);
CREATE INDEX IF NOT EXISTS idx_ula_attempted ON user_login_attempts(attempted_at);

COMMENT ON TABLE user_login_attempts IS 'Audit trail of all login attempts (success and failure)';
COMMENT ON COLUMN user_login_attempts.user_id IS 'FK to users (NULL if user not found)';
COMMENT ON COLUMN user_login_attempts.username IS 'Username attempted (for failed attempts where user does not exist)';
COMMENT ON COLUMN user_login_attempts.success IS 'TRUE if login succeeded, FALSE if failed';
COMMENT ON COLUMN user_login_attempts.failed_reason IS 'Reason for failure (INVALID_PASSWORD, ACCOUNT_LOCKED, etc.)';

-- Create user audit log table
CREATE TABLE IF NOT EXISTS user_audit_log (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT,
    action VARCHAR(50) NOT NULL,
    details TEXT,
    ip_address VARCHAR(45),
    user_agent VARCHAR(500),
    performed_by BIGINT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL,
    FOREIGN KEY (performed_by) REFERENCES users(id) ON DELETE SET NULL
);

CREATE INDEX IF NOT EXISTS idx_ual_user_action ON user_audit_log(user_id, action, created_at);
CREATE INDEX IF NOT EXISTS idx_ual_action ON user_audit_log(action, created_at);
CREATE INDEX IF NOT EXISTS idx_ual_created ON user_audit_log(created_at);

COMMENT ON TABLE user_audit_log IS 'Comprehensive audit trail for all user security events';
COMMENT ON COLUMN user_audit_log.action IS 'Action type: LOGIN_SUCCESS, LOGIN_FAILED, PASSWORD_CHANGE, ROLE_CHANGE, ACCOUNT_LOCKED, ACCOUNT_UNLOCKED, etc.';
COMMENT ON COLUMN user_audit_log.details IS 'JSON with additional context (old/new values, etc.)';
COMMENT ON COLUMN user_audit_log.performed_by IS 'Admin user who performed the action (NULL for self-service)';

-- Add index for security queries
CREATE INDEX idx_users_locked ON users(locked_until) WHERE locked_until IS NOT NULL;
CREATE INDEX idx_users_email_verified ON users(email_verified);

-- =====================================================
-- Data Quality: Clean up any existing data
-- =====================================================

-- Ensure all existing users have failed_login_count = 0
UPDATE users SET failed_login_count = 0 WHERE failed_login_count IS NULL;

