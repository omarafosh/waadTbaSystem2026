-- =====================================================
-- Migration: Add SLA Tracking Fields to PreApprovals
-- Version: V1.15
-- Date: 2026-01-11
-- Purpose: Enable SLA tracking for pre-approval processing
-- =====================================================

-- Add SLA tracking columns to pre_approvals table
ALTER TABLE pre_approvals
ADD COLUMN expected_completion_date DATE,
ADD COLUMN actual_completion_date DATE,
ADD COLUMN within_sla BOOLEAN,
ADD COLUMN business_days_taken INT,
ADD COLUMN sla_days_configured INT;

-- Add column comments (PostgreSQL syntax)
COMMENT ON COLUMN pre_approvals.expected_completion_date IS 'Expected completion date (requestDate + SLA days)';
COMMENT ON COLUMN pre_approvals.actual_completion_date IS 'Actual completion date (when approved/rejected)';
COMMENT ON COLUMN pre_approvals.within_sla IS 'Whether completed within SLA';
COMMENT ON COLUMN pre_approvals.business_days_taken IS 'Business days taken to process';
COMMENT ON COLUMN pre_approvals.sla_days_configured IS 'SLA days at time of creation (default 3)';

-- Add index for SLA monitoring queries
CREATE INDEX idx_pre_approvals_expected_completion ON pre_approvals(expected_completion_date, status);
CREATE INDEX idx_pre_approvals_within_sla ON pre_approvals(within_sla, actual_completion_date);

-- Add comment to table
COMMENT ON TABLE pre_approvals IS 'Pre-approval requests with SLA tracking (Phase 1 - Jan 2026)';

-- Backfill existing records with default SLA (3 business days)
-- Note: This is a one-time operation for existing records
UPDATE pre_approvals
SET sla_days_configured = 3,
    expected_completion_date = request_date + INTERVAL '3 days'
WHERE expected_completion_date IS NULL
  AND request_date IS NOT NULL;

-- Update completed pre-approvals with actual completion date
UPDATE pre_approvals
SET actual_completion_date = COALESCE(medical_reviewed_at, manager_approved_at, created_at)
WHERE status IN ('APPROVED', 'REJECTED', 'CANCELLED')
  AND actual_completion_date IS NULL;

-- Calculate business days taken for completed records (approximation)
-- Note: Actual business days calculation will be done by BusinessDaysCalculatorService
-- PostgreSQL uses DATE subtraction to get days difference
UPDATE pre_approvals
SET business_days_taken = CAST((actual_completion_date - request_date) AS INT)
WHERE actual_completion_date IS NOT NULL
  AND request_date IS NOT NULL
  AND business_days_taken IS NULL;

-- Mark if within SLA (approximation for backfill)
UPDATE pre_approvals
SET within_sla = (business_days_taken <= sla_days_configured)
WHERE business_days_taken IS NOT NULL
  AND sla_days_configured IS NOT NULL
  AND within_sla IS NULL;

